BIDPILOT_ENV=development
BIDPILOT_HOST=127.0.0.1
BIDPILOT_PORT=8000
# local = only this computer; lan = temporary trusted LAN; enterprise = HTTPS gateway + identity boundary
BIDPILOT_NETWORK_ACCESS_MODE=local
# admin_token = prompt remote writers; trusted_lan = no prompt inside trusted private networks
BIDPILOT_LAN_ACCESS_POLICY=admin_token
BIDPILOT_LAN_TRUSTED_NETWORKS=auto
# Required only for lan + admin_token. Use at least 16 random characters.
BIDPILOT_LAN_ADMIN_TOKEN=
# Enterprise mode: exact private client CIDRs, explicit reverse-proxy CIDRs, and exact HTTPS origins.
# Example with Nginx on the same host:
# BIDPILOT_NETWORK_ACCESS_MODE=enterprise
# BIDPILOT_HOST=127.0.0.1
# BIDPILOT_LAN_ACCESS_POLICY=admin_token
# BIDPILOT_LAN_TRUSTED_NETWORKS=10.20.0.0/16
# BIDPILOT_LAN_ADMIN_TOKEN=<at-least-16-random-characters>
# BIDPILOT_TRUSTED_PROXY_NETWORKS=127.0.0.1/32
# BIDPILOT_ENTERPRISE_ALLOWED_ORIGINS=https://bidpilot.example.internal
BIDPILOT_TRUSTED_PROXY_NETWORKS=
BIDPILOT_ENTERPRISE_ALLOWED_ORIGINS=
BIDPILOT_TIMEZONE=Asia/Shanghai
BIDPILOT_EMBEDDED_WORKER=true
BIDPILOT_WORKER_POLL_INTERVAL=3
BIDPILOT_WORKER_LEASE_SECONDS=900
BIDPILOT_WORKER_HEARTBEAT_TTL=30
BIDPILOT_DATA_DIR=data
BIDPILOT_CONTROL_DIR=data
BIDPILOT_REPORT_DIR=outputs/reports
BIDPILOT_DATABASE_PATH=data/bidpilot.db
BIDPILOT_REQUEST_TIMEOUT=20
BIDPILOT_REQUEST_INTERVAL=0.8
BIDPILOT_MAX_RESULTS_PER_SOURCE=20
BIDPILOT_CCGP_MAX_PAGES=2
# auto = desktop visible/server headless; visible = require a graphical session; headless = reuse an already verified profile
BIDPILOT_QIANLIMA_BROWSER_MODE=auto
# Free-member browser queries are bounded even when manually initiated.
BIDPILOT_QIANLIMA_MEMBER_MAX_PAGES=2
BIDPILOT_QIANLIMA_MEMBER_MAX_RESULTS=40
BIDPILOT_QIANLIMA_MEMBER_COOLDOWN_SECONDS=30
BIDPILOT_QIANLIMA_MEMBER_DAILY_QUERY_BUDGET=24
# Keep false unless the deployment has written authorization or official API rights.
BIDPILOT_QIANLIMA_MEMBER_MONITORING_ENABLED=false
# Required when monitoring is enabled; use the contract/API/change-record reference, not credentials.
BIDPILOT_QIANLIMA_MEMBER_MONITORING_AUTHORIZATION_REFERENCE=

# Optional evidence-gated LLM (OpenAI-compatible endpoint)
BIDPILOT_LLM_BASE_URL=
BIDPILOT_LLM_API_KEY=
BIDPILOT_LLM_MODEL=
BIDPILOT_LLM_TIMEOUT=30
BIDPILOT_INTENT_LLM_MODE=auto
BIDPILOT_INTENT_LLM_CONFIDENCE_THRESHOLD=0.85
BIDPILOT_RETRIEVAL_LLM_MODE=auto
BIDPILOT_RETRIEVAL_MAX_ROUNDS=2
BIDPILOT_RETRIEVAL_QUERY_BUDGET_PER_SOURCE=2
BIDPILOT_RETRIEVAL_SEMANTIC_REVIEW=true
BIDPILOT_RETRIEVAL_SEMANTIC_THRESHOLD=0.82
BIDPILOT_RETRIEVAL_SEMANTIC_CANDIDATE_LIMIT=12
BIDPILOT_INTELLIGENCE_BRIEF_MODE=auto
BIDPILOT_INTELLIGENCE_BRIEF_MAX_RECORDS=12
BIDPILOT_DECISION_ASSESSMENT_MODE=auto
BIDPILOT_DECISION_ASSESSMENT_MAX_RECORDS=15

# Optional Feishu delivery
BIDPILOT_FEISHU_WEBHOOK_URL=
BIDPILOT_FEISHU_WEBHOOK_SECRET=
BIDPILOT_FEISHU_APP_ID=
BIDPILOT_FEISHU_APP_SECRET=
BIDPILOT_FEISHU_RECEIVE_ID=
BIDPILOT_FEISHU_RECEIVE_ID_TYPE=chat_id
BIDPILOT_PUBLIC_BASE_URL=

# Optional SMTP email delivery (ssl / starttls / plain)
BIDPILOT_SMTP_HOST=
BIDPILOT_SMTP_PORT=465
BIDPILOT_SMTP_SECURITY=ssl
BIDPILOT_SMTP_USERNAME=
BIDPILOT_SMTP_PASSWORD=
BIDPILOT_SMTP_FROM=
BIDPILOT_SMTP_TO=
BIDPILOT_SMTP_TIMEOUT=30

# Optional DingTalk / WeCom / generic Webhook delivery
BIDPILOT_DINGTALK_WEBHOOK_URL=
BIDPILOT_DINGTALK_WEBHOOK_SECRET=
BIDPILOT_WECOM_WEBHOOK_URL=
BIDPILOT_GENERIC_WEBHOOK_URL=
BIDPILOT_GENERIC_WEBHOOK_BEARER_TOKEN=

# Optional Telegram Bot API delivery
BIDPILOT_TELEGRAM_BOT_TOKEN=
BIDPILOT_TELEGRAM_CHAT_ID=
BIDPILOT_TELEGRAM_MESSAGE_THREAD_ID=
BIDPILOT_TELEGRAM_DISABLE_NOTIFICATION=false
BIDPILOT_TELEGRAM_PROTECT_CONTENT=false

# Optional official Slack Incoming Webhook (messages and report links; no file upload)
BIDPILOT_SLACK_WEBHOOK_URL=
BIDPILOT_DELIVERY_WEBHOOK_TIMEOUT=20
